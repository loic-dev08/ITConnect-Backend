  {
   "name": "2 – Professionnels",
   "item": [
    {
     "name": "TF9 – Recherche de professionnels (route publique)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('TF9 – statut 200', () => pm.response.to.have.status(200))",
         "const j = pm.response.json()",
         "const liste = Array.isArray(j) ? j : (j.professionnels || j.data || [])",
         "pm.test('TF9 – la réponse contient des professionnels', () => pm.expect(liste.length).to.be.above(0))",
         "if (liste[0]) pm.collectionVariables.set('proId', liste[0].id)"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/professionnels?specialite=R%C3%A9seau",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "professionnels"
       ],
       "query": [
        {
         "key": "specialite",
         "value": "R%C3%A9seau"
        }
       ]
      }
     }
    }
   ]
  },
