{
 "info": {
  "name": "ITConnect API",
  "description": "Tests fonctionnels de l'API ITConnect (inscription, connexion, droits, demandes, avis, suppression en cascade). Lancer l'API sur {{baseUrl}} avant d'exécuter la collection.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "name": "1 – Authentification",
   "item": [
    {
     "name": "TF1 – Inscription valide",
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('email', 'postman_' + Date.now() + '@exemple.fr')",
         "pm.collectionVariables.set('motDePasse', 'Test1234!')"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('TF1 – statut 201', () => pm.response.to.have.status(201))",
         "const j = pm.response.json()",
         "pm.test('TF1 – jeton renvoyé', () => pm.expect(j.token).to.be.a('string'))",
         "pm.test('TF1 – rôle particulier', () => pm.expect(j.user.role).to.eql('particulier'))",
         "pm.test('TF1 – aucun hash dans la réponse', () => { pm.expect(j.user).to.not.have.property('motDePasse'); pm.expect(j.user).to.not.have.property('mot_de_passe') })",
         "pm.collectionVariables.set('token', j.token)"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/auth/inscription",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "inscription"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"prenom\": \"Test\",\n  \"nom\": \"Postman\",\n  \"email\": \"{{email}}\",\n  \"motDePasse\": \"{{motDePasse}}\",\n  \"role\": \"particulier\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     }
    },
